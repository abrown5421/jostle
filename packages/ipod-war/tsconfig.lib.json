{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.spec.ts"],
  "references": [
    { "path": "../auth/tsconfig.lib.json" },
    { "path": "../db/tsconfig.lib.json" },
    { "path": "../game-sessions/tsconfig.lib.json" },
    { "path": "../games/tsconfig.lib.json" },
    { "path": "../integrations/tsconfig.lib.json" },
    { "path": "../messaging/tsconfig.lib.json" },
    { "path": "../spotify/tsconfig.lib.json" }
  ]
}

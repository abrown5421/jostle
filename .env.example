MONGO_URI=mongodb_config_uri
PORT=port_number
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1h

# Third-party integrations (@inithium/integrations)
# 32+ random chars - encrypts stored provider credentials and signs OAuth state. Rotating it
# invalidates every stored connection (users will need to reconnect).
INTEGRATIONS_SECRET=replace_with_a_long_random_secret_of_32_plus_chars
# The API's public origin - OAuth redirect URIs are built from it:
#   ${API_PUBLIC_URL}/api/integrations/<provider>/callback
# Spotify rejects "localhost" redirect URIs - use 127.0.0.1 locally.
API_PUBLIC_URL=http://127.0.0.1:3000
# The web app's origin - where the OAuth callback sends the browser back to (also the CORS origin).
WEB_ORIGIN=http://localhost:5173
# From https://developer.spotify.com/dashboard - register the redirect URI
#   http://127.0.0.1:3000/api/integrations/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

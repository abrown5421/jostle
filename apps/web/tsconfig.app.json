{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.app.tsbuildinfo",
    "jsx": "react-jsx",
    "lib": ["dom"],
    "types": [
      "node",
      "@nx/react/typings/cssmodule.d.ts",
      "@nx/react/typings/image.d.ts",
      "vite/client",
      "vitest/importMeta"
    ],
    "rootDir": "src",
    "module": "esnext",
    "moduleResolution": "bundler"
  },
  "exclude": [
    "out-tsc",
    "dist",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.tsx",
    "src/**/*.test.tsx",
    "src/**/*.spec.js",
    "src/**/*.test.js",
    "src/**/*.spec.jsx",
    "src/**/*.test.jsx"
  ],
  "include": ["src/**/*.js", "src/**/*.jsx", "src/**/*.ts", "src/**/*.tsx"],
  "references": [
    {
      "path": "../../packages/ui/tsconfig.lib.json"
    },
    {
      "path": "../../packages/router/tsconfig.lib.json"
    },
    {
      "path": "../../packages/profile-appearance/tsconfig.lib.json"
    },
    {
      "path": "../../packages/presence/tsconfig.lib.json"
    },
    {
      "path": "../../packages/notification-center/tsconfig.lib.json"
    },
    {
      "path": "../../packages/messaging/tsconfig.lib.json"
    },
    {
      "path": "../../packages/lobby/tsconfig.lib.json"
    },
    {
      "path": "../../packages/game-catalog/tsconfig.lib.json"
    },
    {
      "path": "../../packages/integrations-ui/tsconfig.lib.json"
    },
    {
      "path": "../../packages/assets/tsconfig.lib.json"
    }
  ]
}

MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/<database>?appName=<app-name>
PORT=3333
WEB_ORIGIN=http://localhost:5173
API_ORIGIN=http://127.0.0.1:3333
SPOTIFY_CLIENT_ID=<spotify app client id>
SPOTIFY_CLIENT_SECRET=<spotify app client secret>
# 32 random bytes, base64-encoded — e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
INTEGRATION_TOKEN_ENCRYPTION_KEY=<base64-encoded 32-byte key>

# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc

# user-uploaded media (local dev; production uses a Render persistent disk).
# apps/api always serves from its esbuild-bundled dist/main.js, so the
# fallback uploads root resolves relative to that bundle's own directory —
# i.e. sibling to dist/, not inside src/.
apps/api/assets/images

# dependencies
node_modules

# environment secrets
.env
.env.local
.env.*.local

